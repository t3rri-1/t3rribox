# ---- Required ---------------------------------------------------------------
# Fine-grained token: only this repo, permission "Contents: Read and write"
GITHUB_TOKEN=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
# owner/repo (the repo must already contain at least one commit, e.g. a README)
GITHUB_REPO=your-t3rri-1/t3rribox
GITHUB_BRANCH=main
# Your public address, no trailing slash. Used in links, canonical tags and the sitemap
SITE_URL=https://t3rribox.vercel.app

# ---- Google Search Console (use ONE of these) -------------------------------
# "HTML tag" method: just the content="..." value
GOOGLE_SITE_VERIFICATION=
# "HTML file" method: the file name Google gives you, e.g. google1a2b3c4d5e6f7a8b.html
GOOGLE_VERIFICATION_FILE=

# ---- Optional ---------------------------------------------------------------
# true = list uploads in sitemap.xml and let search engines index them
INDEX_FILES=false
MAX_UPLOAD_MB=20
# Extra blocked extensions on top of the built-in list, comma separated
EXTRA_BLOCKED_EXTENSIONS=
# true = read files through the GitHub API instead of raw.githubusercontent.com
GITHUB_RAW_VIA_API=false
